# dependencies
node_modules/

# builds
dist/
dist-ssr/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/

# environment & secrets — NEVER commit real values
.env
.env.*
!.env.example
supabase/.env
supabase/functions/.env
supabase/.temp/
supabase/.branches/
*.pem
*.key
