{
  "name": "mgu-pyq-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Browse and download MG University (Kerala) FYUGP previous-year question papers and schemes of valuation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker": "tsx worker/src/index.ts",
    "worker:once": "tsx worker/src/index.ts --once",
    "crawler:probe": "tsx worker/src/probe.ts",
    "codes:sync": "tsx scripts/sync-course-codes.ts",
    "storage:orphans": "tsx scripts/find-orphaned-objects.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@radix-ui/react-alert-dialog": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "@supabase/supabase-js": "2.45.4",
    "@tanstack/react-query": "5.59.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "jszip": "3.10.1",
    "lucide-react": "0.447.0",
    "node-html-parser": "6.1.13",
    "pdfjs-dist": "4.7.76",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "6.26.2",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "@playwright/test": "1.48.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "eslint": "9.12.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.12",
    "globals": "15.10.0",
    "jsdom": "25.0.1",
    "pdf-lib": "1.17.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.8.1",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
