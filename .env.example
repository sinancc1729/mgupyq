# =============================================================================
# MGU PYQ Hub — environment configuration
# Copy to `.env` (frontend, local dev) and/or `worker/.env` (worker). Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (public) — anything prefixed VITE_ is bundled into the browser build.
# Only put values here that are safe for the whole world to see.
# -----------------------------------------------------------------------------
# Supabase project URL: Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser
# because Row Level Security decides what it can do.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Above this many files OR this many megabytes, "Download all" uses the server-side
# streaming ZIP Edge Function instead of building the ZIP in browser memory.
VITE_CLIENT_ZIP_MAX_FILES=25
VITE_CLIENT_ZIP_MAX_MB=60
# Max PDF size accepted by the admin upload screen (MB). Keep in sync with the bucket limit.
VITE_MAX_PDF_MB=25
# Optional sub-path for static hosting (e.g. /mgu-pyq-hub/ on GitHub Pages). Default "/".
# VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS — worker, scripts and Edge Functions. NEVER prefix with VITE_.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS: keep it on the server.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# -----------------------------------------------------------------------------
# SOURCE WEBSITE / CRAWLER (worker)
# -----------------------------------------------------------------------------
SOURCE_BASE_URL=https://assist.mgu.ac.in/schema/
# Comma-separated hostnames the crawler may contact (SSRF allow-list).
SOURCE_ALLOWED_HOSTS=assist.mgu.ac.in
# Only index pages under this path prefix are followed.
SOURCE_PATH_PREFIX=/schema/
CRAWLER_USER_AGENT=MGU-PYQ-Hub/1.0 (+https://github.com/your-org/mgu-pyq-hub; contact: admin@example.com)
CRAWLER_DELAY_MS=1500
CRAWLER_TIMEOUT_MS=30000
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_DEPTH=4
CRAWLER_MAX_DOWNLOADS_PER_JOB=300
CRAWLER_RESPECT_ROBOTS=true
MAX_PDF_BYTES=26214400

# -----------------------------------------------------------------------------
# WORKER
# -----------------------------------------------------------------------------
# Unique name for this worker instance (shown in job history).
WORKER_ID=worker-1
# How often an idle worker checks for queued jobs.
WORKER_POLL_INTERVAL_MS=15000
# A running job whose heartbeat is older than this is considered abandoned and resumed.
WORKER_STALE_JOB_MS=300000
# Max attempts per document before it is marked failed.
WORKER_MAX_ITEM_ATTEMPTS=3
# Path to the background course-code list.
TARGET_CODES_FILE=config/target-course-codes.json

# -----------------------------------------------------------------------------
# OPTIONAL OCR (disabled by default — nothing is OCR'd unless you enable it)
# Requires the `tesseract` binary and `pdftoppm` (poppler-utils) on the worker host.
# -----------------------------------------------------------------------------
OCR_ENABLED=false
OCR_TESSERACT_PATH=tesseract
OCR_PDFTOPPM_PATH=pdftoppm
OCR_LANG=eng

# -----------------------------------------------------------------------------
# EDGE FUNCTION: course-zip (set with `supabase secrets set ...`)
# -----------------------------------------------------------------------------
ZIP_MAX_FILES=300
ZIP_MAX_TOTAL_MB=800
